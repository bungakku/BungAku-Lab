# Copy to lab.env to override versions.env for this machine. Never committed.
#LAB_HOME=/path/to/state/dir        # default: ./.lab
#LAB_HOST=127.0.0.1
#LAB_PORT=8080
#WP_VERSION=7.0.2
#WP_SOURCE=dir:/srv/wordpress
#LAB_BROWSERS=chromium,firefox,webkit   # default: chromium
#PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
#DB_MODE=external
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_ROOT_USER=root
#DB_ROOT_PASS=secret
