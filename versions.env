# BungAku-Lab: pinned stack. Change a value here, then run `bin/lab doctor`.
# Every value can be overridden in lab.env (not committed) or in the environment.
LAB_VERSION=1.0.0

# WordPress core under test. An exact tag (7.1.5), a branch tag (7.2-RC2) or "trunk".
WP_VERSION=7.1.5
# How to fetch core: auto (zip, then git) | zip | git | dir:/path/to/a/wordpress/tree
WP_SOURCE=auto

# Database. "own" = a private MariaDB started by the lab (socket only, no TCP port).
# "external" = an existing server (the Docker lane uses this).
DB_MODE=own
DB_NAME=wp
DB_USER=wp
DB_PASS=wp
MARIADB_IMAGE_TAG=10.11

# Minimums checked by `lab doctor` (WordPress 7.x needs PHP 7.4+, 8.3 is recommended).
PHP_MIN=7.4
PHP_RECOMMENDED=8.3
NODE_MIN=20

# Browser tooling
PLAYWRIGHT_VERSION=1.63.0
AXE_CORE_VERSION=4.14.1
